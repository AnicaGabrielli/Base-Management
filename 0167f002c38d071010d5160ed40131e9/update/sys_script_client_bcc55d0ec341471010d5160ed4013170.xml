    <sys_script_client action="INSERT_OR_UPDATE">
        <active>true</active>
        <applies_extended>false</applies_extended>
        <condition/>
        <description>Maximum capacity must be greater than zero.</description>
        <field>maximum_capacity</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>Not maximun capcity less then 0</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
    if (isLoading || newValue === '') {
        return;
    }

    var max_capacity = parseFloat(newValue, 10);

    if (!newValue) return;

    if (max_capacity <= 0) {

        g_form.addErrorMessage("The maximum capacity must be greater than zero.");

        g_form.setValue('maximum_capacity', "");

    } else {
		
        g_form.clearMessages();
    }

}]]></script>
