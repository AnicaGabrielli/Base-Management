        <script><![CDATA[var UserByGroupUtils = Class.create();
UserByGroupUtils.prototype = {

    getUsersByGroup: function(groupName) {
        var users = [];

        var gm = new GlideRecord('sys_user_grmember');
        gm.addQuery('group.name', groupName);
        gm.addQuery('user.active', true);
        gm.query();

        while (gm.next()) {
            users.push(gm.getValue('user'));
        }

        return 'sys_idIN' + users.join(',');
    },

    type: 'UserByGroupUtils'
};]]></script>
